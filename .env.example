# Copy this file to .env and fill in your real keys. .env is already in
# .gitignore -- it will not be committed.
#
# Do NOT put real keys in this file (.env.example IS committed).
#
# Note: three keys used to be hardcoded directly in odds_calculator.py and
# are public in this repo's git history. They should be treated as
# compromised -- rotate them at the-odds-api.com rather than reusing them
# here.

# Required. Primary key for the-odds-api.com.
ODDS_API_KEY=

# Optional but recommended. A second key, used automatically the moment the
# primary key is rate-limited or its monthly quota runs out -- so a quota
# hit mid-run doesn't stop the pipeline. Leave blank to run on the primary
# key alone.
ODDS_API_KEY_BACKUP=
